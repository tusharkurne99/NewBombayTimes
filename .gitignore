venv/
__pycache__/
*.pyc

# Large third-party downloads, re-created by setup_evergreen.sh -- not
# worth tracking in git (multi-MB, no diff value).
data/raw/

# Skills are now installed globally (~/.agents/skills/, symlinked from
# ~/.claude/skills/) rather than per-project, so multiple projects can
# share them -- see ~/.agents/skills/ for the actual content. This
# project's .claude/skills/ only holds a symlink pointing there, which is
# an absolute, machine-specific path and would be a broken link for
# anyone else cloning this repo (including you, on a different machine).
.claude/skills/

# maptoposter is a separate cloned tool (its own git repo, its own venv,
# gigabytes of generated poster PNGs) used once to render the Navi Mumbai
# map used on the homepage -- web/assets/navi-mumbai-map.jpg is the only
# output from it that actually belongs in this repo.
maptoposter/
